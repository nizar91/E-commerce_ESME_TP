user www-data;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    sendfile on;
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    upstream front_app {
        # On route vers le front Flask qui tourne en Docker sur la machine hôte
        server 127.0.0.1:{{ front_port }};
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;

        location / {
            proxy_pass http://front_app;
        }
    }
}
